+    <script>
+        (function () {
+            // Sincroniza el encuentro seleccionado con el subidor drag & drop (dropzone),
+            // agregándolo como parámetro de su action para que viaje en la subida AJAX.
+            var sel = document.getElementById('encounter_id');
+            var dzForm = document.querySelector('form.dropzone');
+            if (!sel || !dzForm) {
+                return;
+            }
+            var syncDropzone = function () {
+                var v = sel.value;
+                var url = new URL(dzForm.getAttribute('action'), window.location.href);
+                if (v) {
+                    url.searchParams.set('encounter_id', v);
+                } else {
+                    url.searchParams.delete('encounter_id');
+                }
+                dzForm.setAttribute('action', url.pathname + url.search);
+            };
+            sel.addEventListener('change', syncDropzone);
+            syncDropzone();
+        })();
+    </script>
